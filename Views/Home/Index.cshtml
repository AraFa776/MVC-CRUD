@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome, @ViewBag.UserName!</h1>
    <p>You are logged in as <strong>@ViewBag.UserRole</strong></p>

    @if (User.IsInRole("Admin"))
    {
        <div class="alert alert-success">
            <h4>Admin Access</h4>
            <p>You have full control over items. You can create, edit, and delete items.</p>
            <a href="/Items" class="btn btn-primary">Manage Items</a>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>User Access</h4>
            <p>You can only view items. Contact admin for modifications.</p>
            <a href="/Items" class="btn btn-info">View Items</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        console.log("Welcome to the customized homepage!");
    </script>
}